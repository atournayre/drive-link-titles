{
  "manifest_version": 3,
  "name": "Drive Link Titles",
  "version": "0.3.0",
  "description": "Remplace les liens Google Docs / Sheets / Slides / Forms / Drive par une icône + le nom du document, sur tous les sites (exclusions configurables).",
  "permissions": ["storage"],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://drive.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["lib.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
